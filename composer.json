{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^7.3|^8.0",
        "carlos-meneses/laravel-mpdf": "^2.1",
        "doctrine/dbal": "^3.4",
        "felixkiss/uniquewith-validator": "^3.4",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "intervention/image": "^2.7",
        "kwn/number-to-words": "^2.5",
        "laravel/framework": "^8.75",
        "laravel/sanctum": "^2.11",
        "laravel/tinker": "^2.5",
        "laravel/ui": "^3.4",
        "laravelcollective/html": "^6.3",
        "livewire/livewire": "^2.10",
        "maatwebsite/excel": "^3.1",
        "milon/barcode": "^9.0",
        "nao-pon/flysystem-google-drive": "^1.1",
        "nesbot/carbon": "^2.68",
        "rajibbinalam/laravel-slug-generator": "^0.2.0",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "skycoder/invoice-number-generator": "2.x-dev",
        "skycoder/laravel-filesaver": "2.x-dev",
        "skycoder/query-shorter": "1.0.1.x-dev",
        "spatie/db-dumper": "^2.21",
        "staudenmeir/belongs-to-through": "^2.11"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.7",
        "beyondcode/laravel-dump-server": "^1.8",
        "facade/ignition": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^5.10",
        "phpunit/phpunit": "^9.5.10"
    },
    "autoload": {
        "psr-4": {
            "Module\\": "module/",
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/AppHelper.php",
            "app/Helpers/PermissionHelper.php",
            "app/Helpers/PermissionHelperV2.php",
            "app/Helpers/NewsNotifications.php",
            "app/Helpers/NewTaskNotifications.php",
            "app/Helpers/HelperMethods.php",
            "app/Helpers/QueryFilter.php",
            "app/Helpers/DateFormat.php",
            "app/Helpers/HomepageHelper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "process-timeout":0
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
