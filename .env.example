# ---------------------------------------------------------------------------
# Copy to .env on the server and fill in. Never commit the real .env.
#   cp .env.example .env && php artisan key:generate
# ---------------------------------------------------------------------------

APP_NAME="MM Heritage Hotel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.com

# Set when the app is served from a sub-path or a CDN (leave empty otherwise).
ASSET_URL=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ---------------------------------------------------------------------------
# Database - import database/mmheritagehotel_db.sql first (see DEPLOY-STAGING.md)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mmheritagehotel
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Shared Blade + Tailwind admin shell. Set false for the legacy shell.
MM_ADMIN_SHELL=true

# ---------------------------------------------------------------------------
# Optional integrations - leave empty to disable
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Google Drive uploads (app/Traits/FileSaver.php) are not wired to a disk in this
# version: no 'google' disk exists in config/filesystems.php and no caller uses
# uploadFileToGoogleDrive(). Leave uploads on the local disk until that is done.
